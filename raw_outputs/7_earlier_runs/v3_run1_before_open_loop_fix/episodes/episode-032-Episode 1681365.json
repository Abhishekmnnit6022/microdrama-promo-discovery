            "start": "02:12.00",
            "end": "02:14.00",
            "character": "JULIANA",
            "kind": "dialogue",
            "text": "But look at you."
          },
          {
            "start": "02:15.00",
            "end": "02:18.60",
            "character": "JULIANA",
            "kind": "dialogue",
            "text": "You have to threaten a chained woman to feel powerful!"
